{
  "manifest_version": 2,
  "name": "Companion",
  "version": "0.9.6",
  "permissions": [
    "notifications",
    "storage",
    "identity",
    "alarms",
    "clipboardWrite",
    "tabs",
    "webNavigation",
    "https://mail.google.com/*"
  ],
  "icons": {
    "48": "icon48.png"
  },
  "sidebar_action": {
    "default_title": "Companion",
    "default_panel": "index.html",
    "default_icon": "icon48.png"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+C"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.zoom.us/wc/*",
        "https://meet.google.com/*",
        "https://teams.microsoft.com/meet/*",
        "https://teams.microsoft.com/light-meetings/*",
        "https://*.webex.com/wc/*",
        "https://*.webex.com/meet/*",
        "https://meet.jit.si/*"
      ],
      "js": ["content/prevent-close.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "page": "background.html"
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@mozilla-internal",
      "update_url": "https://raw.githubusercontent.com/mozilla/companion/main/updates.json"
    }
  },
  "default_locale": "en"
}
